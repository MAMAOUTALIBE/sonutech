# Copiez ce fichier en .env. Générez les secrets avec les commandes du README.
# Utilisez uniquement lettres/chiffres pour POSTGRES_PASSWORD (URL PostgreSQL).
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SMTP : à renseigner avant les notifications réelles, jamais dans NEXT_PUBLIC_*.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
DEFAULT_FROM_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=
SMTP_USE_SSL=0
SECURE_SSL_REDIRECT=0
INQUIRY_RATE_LIMIT=10

# Relais privé Next -> Django. Ne jamais exposer ce secret au navigateur.
PROXY_SHARED_SECRET=
# Activer uniquement derrière une entrée réseau de confiance qui écrase X-Real-IP.
TRUST_PROXY_HEADERS=0

# Docker fixe MEDIA_ROOT=/app/media et monte les médias en lecture seule pour Next.
# Hors Docker, variable facultative : chemin absolu des médias Django accessibles à Next.
# MEDIA_ROOT=/chemin/absolu/vers/backend/media

# Assistant IA (service « agent »). Voir docs/AGENT_IA.md.
# Service payant : la clé se crée sur https://platform.claude.com. Jamais dans NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
AGENT_ENABLED=0
# draft : tout est validé par vous ; semi : contacts et formations envoyés seuls, devis validés ; auto : tout sauf les alertes.
AGENT_MODE=draft
AGENT_OWNER_EMAIL=
AGENT_SIGNATURE=L’équipe SONUTECH
# Adresse publique où /api/v1/ est accessible (liens de validation reçus par email).
AGENT_PUBLIC_BASE_URL=http://localhost:8000
AGENT_FOLLOWUP_DAYS=3,7
AGENT_DIGEST_HOUR=8
AGENT_MAX_AUTO_SENDS_PER_HOUR=20
# Développement uniquement : affiche les emails dans les journaux au lieu de les envoyer.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Chatbot Groq : configurez la clé dans /crm/assistant-ia/, pas dans le frontend.
# Compose production utilise un fichier privé partagé backend/assistant.
# Hors Docker, chemin facultatif (défaut : .local/groq.json).
# CHATBOT_SECRET_FILE=/chemin/prive/groq.json

# Documents CRM privés : jamais dans MEDIA_ROOT ni dans les fichiers publics.
# Compose production utilise /app/private/documents sur le volume privé.
# CRM_DOCUMENT_ROOT=/chemin/prive/documents
