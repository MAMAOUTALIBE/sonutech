# Template uniquement : remplacer les domaines/certificats, placer ce serveur
# sur le réseau Compose, monter media_data:/srv/sonutech/media:ro et
# static_data:/srv/sonutech/static:ro. Non chargé par le Compose local.
server {
    listen 80;
    server_name sonutech.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name sonutech.example;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    client_max_body_size 6m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /media/ {
        alias /srv/sonutech/media/;
        autoindex off;
        limit_except GET HEAD { deny all; }
    }
    location /static/ {
        alias /srv/sonutech/static/;
        autoindex off;
        limit_except GET HEAD { deny all; }
    }
    location /api/v1/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Sonutech-Proxy-Secret "";
        proxy_set_header X-Sonutech-Client-IP "";
    }
    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        # Écrase toute valeur envoyée par le visiteur.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Sonutech-Proxy-Secret "";
        proxy_set_header X-Sonutech-Client-IP "";
    }
}
